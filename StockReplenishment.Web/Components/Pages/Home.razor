@page "/"

<PageTitle>Stock Replenishment</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium"
              Class="mt-10">

    <MudPaper Class="pa-8">

        <MudText Typo="Typo.h3">
            Stock Replenishment Request System
        </MudText>

        <MudText Typo="Typo.body1"
                 Class="mt-3">

            Create, submit, approve, reject,
            and fulfill stock replenishment requests.

        </MudText>

        <MudDivider Class="my-6" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Href="/requests">

            Open Requests

        </MudButton>

    </MudPaper>

</MudContainer>